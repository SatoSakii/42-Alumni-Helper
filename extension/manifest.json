{
    "manifest_version": 3,
    "name": "42 Alumni Helper",
    "version": "1.0.0",
    "key": "",
    "description": "Recalcule et corrige l'affichage du level 42cursus quand le compte est passé alumni",
    "permissions": ["identity", "storage"],
    "host_permissions": [
        "https://api.intra.42.fr/*",
        "https://profile.intra.42.fr/*",
        "https://raw.githubusercontent.com/*",
        "https://42-alumni-helper.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://profile.intra.42.fr/*"],
            "js": [
                "content/config.js",
                "content/cache.js",
                "content/level-engine.js",
                "content/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
